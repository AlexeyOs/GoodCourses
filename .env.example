APP_HOST=https://goodcourses.example.com
PORT=8080
DATABASE_URL=postgresql://goodcourses:change-me@host.example.com/goodcourses?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
MIGRATION_DATABASE_URL=postgresql://goodcourses_migrator:change-me@host.example.com/goodcourses?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
REMEMBER_ME_KEY=generate-a-long-random-value

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=goodcourses@example.com
SMTP_FROM_NAME=GoodCourses

FACEBOOK_CLIENT_ID=disabled
FACEBOOK_SECRET=disabled
DB_POOL_INITIAL_SIZE=0
DB_POOL_MAX_SIZE=3
TOMCAT_MAX_THREADS=20
TOMCAT_ACCEPT_COUNT=20
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:MaxMetaspaceSize=96m -Xss512k -XX:+UseSerialGC
